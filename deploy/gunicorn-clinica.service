# Copiar para: /etc/systemd/system/gunicorn-clinica.service
[Unit]
Description=Gunicorn - Clinica Veterinaria (Django)
After=network.target postgresql.service

[Service]
User=clinica
Group=www-data
WorkingDirectory=/srv/clinica_vet
RuntimeDirectory=clinica_vet
ExecStart=/srv/clinica_vet/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --timeout 120 \
    --bind unix:/run/clinica_vet/gunicorn.sock \
    --umask 007 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
