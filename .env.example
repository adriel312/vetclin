# ─── Django ────────────────────────────────────────────────────────────────────
# Gere uma chave nova:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False
# Domínio(s) + IP do VPS, separados por vírgula, sem espaço e sem http://
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br,IP_DO_VPS
# Com https:// — necessário para o login do admin funcionar
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br
# Mude para True somente depois de instalar o certificado SSL (certbot)
HTTPS_ENABLED=False
# Opcional, depois que o HTTPS estiver estável por alguns dias: 31536000
SECURE_HSTS_SECONDS=0

# ─── Banco de dados (PostgreSQL no próprio VPS) ────────────────────────────────
DB_NAME=clinica_vet
DB_USER=clinica_user
DB_PASSWORD=senha-forte-do-banco
DB_HOST=localhost
DB_PORT=5432

# ─── Imagens ───────────────────────────────────────────────────────────────────
# No VPS as imagens ficam em disco (pasta media/). Deixe False.
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── WhatsApp (botão flutuante) ────────────────────────────────────────────────
WHATSAPP_NUMBER=5561999999999
WHATSAPP_MESSAGE=Olá! Vim pelo site e gostaria de mais informações.

# ─── E-mail (formulário de contato) ───────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=clinica@email.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=clinica@email.com
CONTACT_EMAIL=clinica@email.com
